package {{domain}}.{{lib_name}};

import java.lang.foreign.*;
import java.lang.invoke.MethodHandle;
import java.lang.invoke.VarHandle;
import java.nio.charset.StandardCharsets;
{%- if uses_optional %}
import java.util.Optional;
{%- endif %}
{%- if has_callbacks %}
import java.lang.invoke.MethodHandles;
import java.lang.invoke.MethodType;
{%- endif %}

{{docs}}public class {{type_name}}{% if is_error %} extends RuntimeException{% endif %}
    {%- if special_methods.comparator %} implements Comparable<{{type_name}}>{% endif %} {

    static final StructLayout LAYOUT = MemoryLayout.structLayout(
        {{layout_members}}
    );
    {%- for vh in var_handles %}
    private static final VarHandle {{vh.handle_name}} = {{vh.declaration}};
    {%- endfor %}
    {%- for oc in offset_consts %}
    private static final long {{oc.const_name}} = {{oc.declaration}};
    {%- endfor %}
    {%- if !native_methods.is_empty() %}

    private static final Linker LINKER = Linker.nativeLinker();
    private static final SymbolLookup LIB;

    {%- for m in native_methods %}
    private static final MethodHandle {{m.handle_name}};
    {%- endfor %}
    {%- for m in native_methods %}
    {%- if let Some(layout) = &m.result_layout %}
    static final StructLayout {{m.result_layout_name.as_ref().unwrap()}} = {{layout}};
    {%- endif %}
    {%- endfor %}

    static {
        System.loadLibrary("{{dylib_name}}");
        LIB = SymbolLookup.loaderLookup();
        {%- for m in native_methods %}
        {{m.handle_name}} = LINKER.downcallHandle(
            LIB.find("{{m.abi_name}}").orElseThrow(),
            {{m.descriptor}}
        );
        {%- endfor %}
    }
    {%- endif %}
{%- for iface in callback_interfaces %}

{{iface}}
{%- endfor %}
{%- for runner in callback_runners %}

{{runner}}
{%- endfor %}
{%- for s in callback_statics %}

{{s}}
{%- endfor %}
    {%- for f in fields %}

{{f.docs}}    public {{f.java_type}} {{f.field_name}};
    {%- endfor %}

    {%- if !has_zero_arg_constructor %}

    public {{type_name}}() {
        {%- if is_error %}
        super("{{type_name}}");
        {%- endif %}
    }
    {%- else %}

    private {{type_name}}(Void _internal) {
        {%- if is_error %}
        super("{{type_name}}");
        {%- endif %}
    }
    {%- endif %}

    {%- if !fields.is_empty() && !has_constructors %}

    {{type_name}}({% for f in fields %}{{f.java_type}} {{f.field_name}}{% if !loop.last %}, {% endif %}{% endfor %}) {
        {%- if is_error %}
        super("{{type_name}}");
        {%- endif %}
        {%- for f in fields %}
        this.{{f.field_name}} = {{f.field_name}};
        {%- endfor %}
    }
    {%- endif %}
    {%- for m in constructor_methods %}

{{m.docs}}    {{m.definition}}
    {%- endfor %}

    static {{type_name}} fromNative(MemorySegment seg) {
        {%- if has_constructors %}
        {%- if has_zero_arg_constructor %}
        var result = new {{type_name}}((Void) null);
        {%- else %}
        var result = new {{type_name}}();
        {%- endif %}
        {%- for f in fields %}
        result.{{f.field_name}} = {{f.from_native_expr}};
        {%- endfor %}
        return result;
        {%- else if fields.is_empty() %}
        return new {{type_name}}();
        {%- else %}
        return new {{type_name}}(
            {%- for f in fields %}
            {{f.from_native_expr}}{% if !loop.last %},{% endif %}
            {%- endfor %}
        );
        {%- endif %}
    }
    {%- if !is_out_struct %}

    MemorySegment toNative(Arena arena) {
        var seg = arena.allocate(LAYOUT);
        {%- for f in fields %}
        {{f.to_native_stmt}}
        {%- endfor %}
        return seg;
    }

    void updateFromNative(MemorySegment seg) {
        {%- for f in fields %}
        this.{{f.field_name}} = {{f.from_native_expr}};
        {%- endfor %}
    }
    {%- endif %}
    {%- for m in companion_methods %}

{{m.docs}}    {{m.definition}}
    {%- endfor %}
    {%- for m in self_methods %}

{{m.docs}}    {{m.definition}}
    {%- endfor %}
}
