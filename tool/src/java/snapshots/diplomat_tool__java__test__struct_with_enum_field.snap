package dev.diplomattest.somelib;

import java.lang.foreign.*;
import java.lang.invoke.MethodHandle;
import java.lang.invoke.VarHandle;
import java.nio.charset.StandardCharsets;

public class Movement {

    static final StructLayout LAYOUT = MemoryLayout.structLayout(
        ValueLayout.JAVA_INT.withName("direction"),
        MemoryLayout.paddingLayout(4),
        ValueLayout.JAVA_DOUBLE.withName("distance")
    );
    private static final VarHandle VH_DIRECTION = LAYOUT.varHandle(MemoryLayout.PathElement.groupElement("direction"));
    private static final VarHandle VH_DISTANCE = LAYOUT.varHandle(MemoryLayout.PathElement.groupElement("distance"));

    public Direction direction;

    public double distance;

    public Movement() {
    }

    Movement(Direction direction, double distance) {
        this.direction = direction;
        this.distance = distance;
    }

    static Movement fromNative(MemorySegment seg) {
        return new Movement(
            Direction.fromNative((int) VH_DIRECTION.get(seg, 0L)),
            (double) VH_DISTANCE.get(seg, 0L)
        );
    }

    MemorySegment toNative(Arena arena) {
        var seg = arena.allocate(LAYOUT);
        VH_DIRECTION.set(seg, 0L, this.direction.toNative());
        VH_DISTANCE.set(seg, 0L, this.distance);
        return seg;
    }

    void updateFromNative(MemorySegment seg) {
        this.direction = Direction.fromNative((int) VH_DIRECTION.get(seg, 0L));
        this.distance = (double) VH_DISTANCE.get(seg, 0L);
    }
}
package dev.diplomattest.somelib;

import java.lang.foreign.*;
import java.lang.invoke.MethodHandle;
import java.nio.charset.StandardCharsets;

public enum Direction {
    NORTH(0),
    SOUTH(1),
    EAST(2),
    WEST(3);

    private final int value;

    Direction(int value) {
        this.value = value;
    }

    public int toNative() {
        return this.value;
    }

    public static Direction fromNative(int value) {
        for (var variant : values()) {
            if (variant.value == value) {
                return variant;
            }
        }
        throw new IllegalArgumentException("Invalid native value for Direction: " + value);
    }
}
