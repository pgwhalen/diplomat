package dev.diplomattest.somelib;

import java.lang.foreign.*;
import java.lang.invoke.MethodHandle;
import java.lang.invoke.VarHandle;
import java.nio.charset.StandardCharsets;

public class Inner {

    static final StructLayout LAYOUT = MemoryLayout.structLayout(
        ValueLayout.JAVA_INT.withName("x"),
        ValueLayout.JAVA_INT.withName("y")
    );
    private static final VarHandle VH_X = LAYOUT.varHandle(MemoryLayout.PathElement.groupElement("x"));
    private static final VarHandle VH_Y = LAYOUT.varHandle(MemoryLayout.PathElement.groupElement("y"));

    public int x;

    public int y;

    public Inner() {
    }

    Inner(int x, int y) {
        this.x = x;
        this.y = y;
    }

    static Inner fromNative(MemorySegment seg) {
        return new Inner(
            (int) VH_X.get(seg, 0L),
            (int) VH_Y.get(seg, 0L)
        );
    }

    MemorySegment toNative(Arena arena) {
        var seg = arena.allocate(LAYOUT);
        VH_X.set(seg, 0L, this.x);
        VH_Y.set(seg, 0L, this.y);
        return seg;
    }

    void updateFromNative(MemorySegment seg) {
        this.x = (int) VH_X.get(seg, 0L);
        this.y = (int) VH_Y.get(seg, 0L);
    }
}package dev.diplomattest.somelib;

import java.lang.foreign.*;
import java.lang.invoke.MethodHandle;
import java.lang.invoke.VarHandle;
import java.nio.charset.StandardCharsets;

public class Outer {

    static final StructLayout LAYOUT = MemoryLayout.structLayout(
        Inner.LAYOUT.withName("inner"),
        ValueLayout.JAVA_DOUBLE.withName("z")
    );
    private static final VarHandle VH_Z = LAYOUT.varHandle(MemoryLayout.PathElement.groupElement("z"));
    private static final long OFFSET_INNER = LAYOUT.byteOffset(MemoryLayout.PathElement.groupElement("inner"));

    public Inner inner;

    public double z;

    public Outer() {
    }

    Outer(Inner inner, double z) {
        this.inner = inner;
        this.z = z;
    }

    static Outer fromNative(MemorySegment seg) {
        return new Outer(
            Inner.fromNative(seg.asSlice(OFFSET_INNER, Inner.LAYOUT.byteSize())),
            (double) VH_Z.get(seg, 0L)
        );
    }

    MemorySegment toNative(Arena arena) {
        var seg = arena.allocate(LAYOUT);
        seg.asSlice(OFFSET_INNER, Inner.LAYOUT.byteSize()).copyFrom(this.inner.toNative(arena));
        VH_Z.set(seg, 0L, this.z);
        return seg;
    }

    void updateFromNative(MemorySegment seg) {
        this.inner = Inner.fromNative(seg.asSlice(OFFSET_INNER, Inner.LAYOUT.byteSize()));
        this.z = (double) VH_Z.get(seg, 0L);
    }
}
